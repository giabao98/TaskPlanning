# Biến Môi Trường - Sao chép file này thành .env và điền giá trị phù hợp
# KHÔNG commit file .env lên git

# =============================================================================
# DATABASE (PostgreSQL via Docker)
# =============================================================================
# Dùng docker-compose up -d để khởi động DB local
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/webtemplate?schema=public"

# =============================================================================
# AUTH.JS (NextAuth v5)
# =============================================================================
# Tạo secret bằng: openssl rand -base64 32
AUTH_SECRET="your-super-secret-auth-key-change-me"

# URL của app khi deploy production (để NextAuth tạo redirect URL đúng)
# NEXTAUTH_URL="https://yourdomain.com"

# =============================================================================
# API (Axios Client)
# =============================================================================
# Base URL cho API calls từ frontend
# Nếu để trống, mặc định sẽ dùng /api (internal Next.js API routes)
NEXT_PUBLIC_API_URL=""

# =============================================================================
# OAUTH PROVIDERS (Tuỳ chọn - bỏ comment provider nào mày muốn dùng)
# =============================================================================

# --- GitHub ---
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# --- Google ---
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- Facebook ---
# FACEBOOK_CLIENT_ID=""
# FACEBOOK_CLIENT_SECRET=""

# =============================================================================
# OPTIONAL: Error Tracking (Sentry)
# =============================================================================
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
